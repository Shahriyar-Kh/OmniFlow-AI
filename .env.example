# Copy to .env. Replace every CHANGE_ME value before starting services.
COMPOSE_PROJECT_NAME=tbos_automation
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TIMEZONE=Asia/Karachi
APP_OPENAPI_ENABLED=true
APP_VERSION=0.2.0
INTERNAL_API_KEY=CHANGE_ME_generate_a_random_internal_api_key

# PostgreSQL bootstrap superuser (local Docker network only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_local_password
POSTGRES_DB=postgres

# TechBuilt application database
APP_DB_NAME=tbos_content
APP_DB_USER=tbos_app
APP_DB_PASSWORD=CHANGE_ME_app_local_password
DATABASE_URL=postgresql+psycopg://tbos_app:CHANGE_ME_app_local_password@postgres:5432/tbos_content

# n8n database and local web service
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_n8n_db_local_password
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=CHANGE_ME_use_at_least_32_random_characters
N8N_USER_FOLDER=/home/node/.n8n
N8N_INTERNAL_URL=http://n8n:5678

# Native Windows Ollama. qwen3:4b is the low-memory profile; model pulls require approval.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_ENABLED=false

# Google Gemini API (Primary Engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=60
AI_PRIMARY_PROVIDER=gemini

# Content-engine configuration
TOPIC_LIBRARY_PATH=/workspace/config/topics.yaml
PROMPT_TEMPLATES_PATH=/workspace/config/prompts
MODEL_PROFILES_PATH=/workspace/config/model_profiles.yaml
QA_PASS_THRESHOLD=85
FACEBOOK_HASHTAG_LIMIT=15
INSTAGRAM_HASHTAG_LIMIT=5
TIKTOK_HASHTAG_LIMIT=5

# Container paths shared by workflows and renderer jobs
SHARED_STORAGE_PATH=/workspace/storage
N8N_SHARED_STORAGE_PATH=/files

# Future integrations: placeholders only, never commit real values
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

FEATURE_TELEGRAM_ENABLED=false
FEATURE_META_ENABLED=false
FEATURE_R2_ENABLED=false
FEATURE_OLLAMA_ENABLED=false
